# Server
PORT=8200

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Postgres
DATABASE_URL=
NODE_TLS_REJECT_UNAUTHORIZED=0

# OCR service
OCR_SERVICE_URL=http://localhost:2000/extract-text

# S3 (object storage)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

# External ICD predictor gateway
ICD_GATEWAY_URL=
ICD_GATEWAY_TOKEN=

# Admin (env-based admin login + admin bearer token)
# REQUIRED — server fails to start without these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN=

# JWT signing key for user auth tokens (signup / login flow)
# REQUIRED. Use a long random hex string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_EXPIRES_IN=24h

# SMTP — used for OTP and account emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MedCode AI
SMTP_FROM_EMAIL=

# App URLs (used in email templates)
APP_URL=
APP_LOGIN_URL=
